<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>..\..\ConsoleApp1\Plugins\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VehicleCore\VehicleCore.csproj" />
  </ItemGroup>

  <Target Name="CopyVehicleCoreToPlugins" AfterTargets="Build">
    <Copy SourceFiles="..\..\VehicleCore\bin\$(Configuration)\net8.0\VehicleCore.dll"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
